# ─── GitHub Models — tokens de acesso ────────────────────────────────────────
# Gere em: https://github.com/settings/tokens
# Cada token tem limite de 50 requisições/dia no GitHub Models.
# O sistema faz rotação automática entre os três tokens.
GITHUB_TOKEN=ghp_SEU_TOKEN_AQUI
GITHUB_TOKEN_2=ghp_SEU_TOKEN_AQUI
GITHUB_TOKEN_3=ghp_SEU_TOKEN_AQUI
GITHUB_TOKEN_4=ghp_SEU_TOKEN_AQUI
GITHUB_TOKEN_5=ghp_SEU_TOKEN_AQUI
GITHUB_TOKEN_6=ghp_SEU_TOKEN_AQUI
GITHUB_TOKEN_7=ghp_SEU_TOKEN_AQUI

# ─── Configurações opcionais ──────────────────────────────────────────────────
# Timeout em segundos para chamadas LLM (padrão: 60)
LLM_TIMEOUT=120
